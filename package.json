{
	"name": "servitor-cms",
	"private": true,
	"version": "0.4.0",
	"description": "Self-hostable, multilingual CMS for blog posts and articles, with a review workflow, a read-only REST API and webhooks.",
	"license": "Apache-2.0",
	"homepage": "https://servitor.rua.systems",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Rua-Systems/servitor-cms.git"
	},
	"bugs": {
		"url": "https://github.com/Rua-Systems/servitor-cms/issues"
	},
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build && vite build --config vite.cli.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"i18n:compile": "paraglide-js compile --project ./project.inlang --outdir ./src/lib/paraglide --strategy custom-request custom-document baseLocale --emit-ts-declarations --silent",
		"check": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"check:watch": "npm run i18n:compile && svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint . --max-warnings 0 && markdownlint-cli2",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run && npm run test:e2e",
		"test:e2e": "playwright install && playwright test",
		"db:generate": "drizzle-kit generate",
		"auth:schema": "auth generate --config src/lib/server/auth/schema-config.ts --output src/lib/server/db/auth.schema.ts --yes",
		"sbom": "npm sbom --sbom-format cyclonedx --sbom-type application --omit dev"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@inlang/paraglide-js": "^2.29.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.61.0",
		"@playwright/test": "^1.64.1",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/better-sqlite3": "^9.6.0",
		"@types/node": "^24",
		"@types/sanitize-html": "^2.16.2",
		"auth": "^1.7.13",
		"bits-ui": "^2.20.2",
		"cn": "^0.5.0",
		"drizzle-kit": "^0.31.11",
		"eslint": "^10.13.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.23.1",
		"globals": "^17.13.0",
		"markdownlint-cli2": "^0.24.0",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.7.1",
		"svelte": "^5.57.2",
		"svelte-check": "^4.7.7",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.0",
		"vite": "^8.3.5",
		"vitest": "^5.0.5"
	},
	"dependencies": {
		"@floating-ui/dom": "^1.8.0",
		"@sindresorhus/slugify": "^3.0.1",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-bubble-menu": "^3.32.0",
		"@tiptap/extension-code-block-lowlight": "^3.32.0",
		"@tiptap/extension-highlight": "^3.32.0",
		"@tiptap/extension-list": "^3.31.3",
		"@tiptap/extension-mathematics": "^3.32.0",
		"@tiptap/extension-table": "^3.32.0",
		"@tiptap/extension-text-style": "^3.32.0",
		"@tiptap/extensions": "^3.31.3",
		"@tiptap/html": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@tiptap/starter-kit": "^3.32.0",
		"@tiptap/suggestion": "^3.32.0",
		"better-auth": "^1.7.13",
		"better-sqlite3": "^13.0.3",
		"drizzle-orm": "^0.45.4",
		"happy-dom": "^20.14.5",
		"katex": "^0.19.1",
		"lowlight": "^3.3.0",
		"marked": "^18.1.1",
		"nodemailer": "^10.2.1",
		"pino": "^10.4.0",
		"sanitize-html": "^2.18.1",
		"sharp": "^0.35.5",
		"tar": "^7.5.22",
		"uqr": "^0.1.3",
		"zod": "^4.6.7"
	},
	"allowScripts": {
		"esbuild@0.25.12": true,
		"esbuild@0.28.2": true,
		"better-sqlite3@13.0.3": true
	},
	"overrides": {
		"@sveltejs/kit": {
			"cookie": "^0.7.2"
		},
		"@esbuild-kit/core-utils": {
			"esbuild": "^0.25.12"
		}
	}
}
